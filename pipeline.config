# Configuration file for Jenkins Pipeline Execution

# ============= Git Configuration =============
GIT_REPO=https://github.com/spring-projects/spring-petclinic.git
GIT_BRANCH=main
GIT_CREDENTIALS_ID=github-credentials

# ============= Build Configuration =============
JAVA_VERSION=11
MAVEN_HOME=/usr/share/maven
MAVEN_OPTIONS=-Xmx256m -XX:MaxPermSize=512m

# ============= SonarQube Configuration =============
SONAR_ENABLED=true
SONAR_HOST_URL=http://sonarqube:9000
SONAR_AUTH_TOKEN=your-sonar-token
SONAR_QUALITY_GATE_WAIT=true
SONAR_QUALITY_GATE_TIMEOUT=300

# ============= Docker Configuration =============
REGISTRY_URL=your-registry.azurecr.io
REGISTRY_USERNAME=your-username
REGISTRY_PASSWORD=your-password
APP_NAME=spring-petclinic
DOCKER_BUILD_ARGS=--build-arg BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ') --build-arg VCS_REF=$(git rev-parse --short HEAD)

# ============= Trivy Configuration =============
TRIVY_ENABLED=true
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_FAIL_ON_CRIT=false
TRIVY_REPORT_FORMAT=json,table

# ============= Azure Configuration =============
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_TENANT_ID=your-tenant-id
AZURE_SP_ID=your-service-principal-id
AZURE_SP_PASSWORD=your-service-principal-password

# ============= AKS Configuration =============
AKS_CLUSTER_NAME=your-aks-cluster
AKS_NAMESPACE=default
AKS_REPLICAS=3

# ============= Artifact Configuration =============
ARTIFACT_REPOSITORY=artifactory-server
ARTIFACT_RETENTION_DAYS=30

# ============= Notification Configuration =============
NOTIFICATION_ENABLED=true
SLACK_WEBHOOK_URL=your-slack-webhook
EMAIL_RECIPIENTS=devops@company.com

# ============= Pipeline Options =============
PIPELINE_TIMEOUT_MINUTES=60
SKIP_TESTS=false
SKIP_SONAR=false
DEPLOY_ON_SUCCESS=true
ROLLBACK_ON_FAILURE=true
